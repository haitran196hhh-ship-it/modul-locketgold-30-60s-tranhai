[Rule]
# Tối ưu kết nối Locket & Chặn quảng cáo UDP
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
# Xóa ETag của RevenueCat để ép Locket luôn tải chứng chỉ Gold mới nhất
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del if-none-match

[Script]
# 1. Xóa Header đệm của RevenueCat
Locket_DeleteHeader_TrHai307 = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/modul-locketgold-30-60s-tranhai/refs/heads/main/deleteheader.js, timeout=60

# 2. Mở khóa Locket Gold Vĩnh Viễn (2099)
Locket_Gold_TrHai307 = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/modul-locketgold-30-60s-tranhai/refs/heads/main/locket_gold_30s_trhai307.js, requires-body=true, max-size=-1, timeout=60

# 3. Mở khóa Quay Video 30s/60s + Mở khóa toàn bộ Khung Ảnh (Frames & Overlays) trên Firebase Remote Config
Locket_30s_And_Frames_TrHai307 = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/modul-locketgold-30-60s-tranhai/refs/heads/main/locket_gold_30s_trhai307.js, requires-body=true, max-size=-1, timeout=60

# 4. Tự động áp dụng Khung màu Caption Gradient VIP khi đăng bài (Có thể chỉnh màu tại argument)
Locket_Custom_Overlay_TrHai307 = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/(postMomentV2|createMoment), script-path=https://raw.githubusercontent.com/haitran196hhh-ship-it/modul-locketgold-30-60s-tranhai/refs/heads/main/locket_gold_30s_trhai307.js, requires-body=true, max-size=-1, timeout=60, argument="{\"enableCustomFrame\":true,\"frameStyle\":\"gold_vip\",\"textColor\":\"#FFFFFF\",\"bgGradientTop\":\"#F59E0B\",\"bgGradientBottom\":\"#B45309\"}"

[MITM]
hostname = %APPEND%, api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
